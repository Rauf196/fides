# copy to .env and fill in values
# loaded by dotenvy at startup

# database connection (highest priority override for database.url)
DATABASE_URL=postgres://user:password@localhost:5432/fides

# all config fields can be overridden with FIDES__<SECTION>__<FIELD>
# double underscore separates nesting levels
#
# FIDES__SERVER__GRPC_PORT=50051
# FIDES__SERVER__HTTP_PORT=9090
# FIDES__SERVER__SHUTDOWN_TIMEOUT_SECS=30
# FIDES__DATABASE__MAX_CONNECTIONS=10
# FIDES__DATABASE__MIN_CONNECTIONS=1
# FIDES__DATABASE__ACQUIRE_TIMEOUT_SECS=5
# FIDES__DATABASE__IDLE_TIMEOUT_SECS=600
# FIDES__LOGGING__LEVEL=info
# FIDES__LOGGING__FORMAT=json
# FIDES__OBSERVABILITY__INTEGRITY_CHECK_INTERVAL_SECS=60
